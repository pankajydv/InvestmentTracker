{
  "envDefaults": {
    "APP_MODE": "dev",
    "PORT": 4000,
    "DATA_DIR": "./data",
    "ALLOW_DB_MIGRATIONS": true,
    "AUTH_DISABLED": true,
    "GOOGLE_CLIENT_ID": "",
    "ALLOWED_EMAILS": "abc.xyz@gmail.com",
    "SESSION_SECRET": "dev-only-change-me",
    "APP_LOG_DIR": "./data/logs",
    "ENABLE_STARTUP_COMPLIANCE": false,
    "ENABLE_STARTUP_PREFLIGHT": false
  },
  "scheduler": {
    "enabled": true,
    "timezone": "Asia/Kolkata",
    "schedules": {
      "intradayStocks": "9:25 AM - 4:25 PM IST (weekdays)",
      "dailyFinal": "10:25 PM IST (weekdays)"
    }
  },
  "auth": {
    "provider": "google",
    "authDisabled": true,
    "allowedEmails": [
      "abc.xyz@gmail.com"
    ]
  },
  "database": {
    "type": "sqlite",
    "filename": "investments.db",
    "walMode": true,
    "location": "./data/investments.db"
  },
  "monitoring": {
    "healthCheckEndpoint": "/api/auth/config",
    "healthCheckInterval": 30
  }
}
