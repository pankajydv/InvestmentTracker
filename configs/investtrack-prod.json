{
  "oracle": {
    "host": "92.4.90.130",
    "user": "ubuntu",
    "port": 22,
    "deployDir": "/home/ubuntu/investment-tracker",
    "envFile": "/opt/investment-tracker.env",
    "dataDir": "/data",
    "backupScript": "/usr/local/bin/investment-backup.sh"
  },
  "deployment": {
    "enableScheduler": true,
    "enableAuth": true,
    "allowDbMigrations": false,
    "backupBeforeDeploy": true,
    "domain": "investtrack.duckdns.org"
  },
  "envDefaults": {
    "APP_MODE": "production",
    "PORT": 8080,
    "DATA_DIR": "/data",
    "ENABLE_SCHEDULER": true,
    "ALLOW_DB_MIGRATIONS": false,
    "AUTH_DISABLED": false,
    "GOOGLE_CLIENT_ID": "",
    "ALLOWED_EMAILS": "abc.xyz@gmail.com",
    "SESSION_SECRET": "change-me-in-env-file",
    "APP_LOG_DIR": "/data/logs",
    "APP_LOG_RETENTION_DAYS": 30,
    "APP_LOG_TO_CONSOLE": false,
    "INTRADAY_BACKFILL_MAX_SCOPES": 25,
    "ENABLE_INTRADAY_COMPLIANCE": false,
    "ENABLE_STARTUP_COMPLIANCE": true,
    "ENABLE_STARTUP_PREFLIGHT": true,
    "NIGHTLY_MARKET_CACHE_WARM_DAYS": 5,
    "ENABLE_HISTORICAL_PRICE_AUDIT": true,
    "HISTORICAL_PRICE_AUDIT_DRY_RUN": true,
    "HISTORICAL_PRICE_AUDIT_WINDOW_DAYS": 5,
    "ENABLE_HISTORICAL_PRICE_REPAIR_WORKER": true,
    "HISTORICAL_PRICE_REPAIR_BATCH_SIZE": 10,
    "HISTORICAL_PRICE_REPAIR_MAX_ATTEMPTS": 3,
    "INCREMENTAL_COMPLIANCE_LOOKBACK_DAYS": 14,
    "NAV_COMPLIANCE_ASSET_TYPES": "MF,NPS",
    "NAV_COMPLIANCE_WARN_AFTER_SESSIONS": 2.0
  },
  "docker": {
    "imageName": "investment-tracker",
    "imageTag": "latest",
    "containerName": "investment-tracker",
    "port": 8080,
    "restartPolicy": "unless-stopped"
  },
  "scheduler": {
    "enabled": true,
    "timezone": "Asia/Kolkata",
    "schedules": {
      "intradayStocks": "9:35 AM - 4:35 PM IST (weekdays)",
      "dailyFinal": "10:35 PM IST (all days)"
    }
  },
  "backup": {
    "retentionDays": 30,
    "schedule": "02:30 UTC daily (via cron)"
  },
  "auth": {
    "provider": "google",
    "authDisabled": false,
    "allowedEmails": [
      "abc.xyz@gmail.com"
    ]
  },
  "database": {
    "type": "sqlite",
    "filename": "investments.db",
    "walMode": true,
    "location": "/data/investments.db"
  },
  "monitoring": {
    "healthCheckEndpoint": "/api/auth/config",
    "healthCheckInterval": 30
  }
}
