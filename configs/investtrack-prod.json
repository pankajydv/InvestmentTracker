{
  "oracle": {
    "host": "92.4.90.130",
    "user": "ubuntu",
    "port": 22,
    "deployDir": "/home/ubuntu/investment-tracker",
    "envFile": "/opt/investment-tracker.env",
    "dataDir": "/data",
    "backupScript": "/usr/local/bin/investment-backup.sh"
  },
  "deployment": {
    "enableScheduler": true,
    "enableAuth": true,
    "allowDbMigrations": false,
    "backupBeforeDeploy": true,
    "domain": "investtrack.duckdns.org"
  },
  "envDefaults": {
    "APP_MODE": "production",
    "PORT": 8080,
    "DATA_DIR": "/data",
    "ALLOW_DB_MIGRATIONS": false,
    "AUTH_DISABLED": false,
    "GOOGLE_CLIENT_ID": "",
    "ALLOWED_EMAILS": "abc.xyz@gmail.com",
    "SESSION_SECRET": "change-me-in-env-file",
    "APP_LOG_DIR": "/data/logs",
    "ENABLE_STARTUP_COMPLIANCE": true,
    "ENABLE_STARTUP_PREFLIGHT": true
  },
  "docker": {
    "imageName": "investment-tracker",
    "imageTag": "latest",
    "containerName": "investment-tracker",
    "port": 8080,
    "restartPolicy": "unless-stopped"
  },
  "scheduler": {
    "enabled": true,
    "timezone": "Asia/Kolkata",
    "schedules": {
      "intradayStocks": "9:35 AM - 4:35 PM IST (weekdays)",
      "dailyFinal": "10:35 PM IST (all days)"
    }
  },
  "backup": {
    "retentionDays": 30,
    "schedule": "02:30 UTC daily (via cron)"
  },
  "auth": {
    "provider": "google",
    "authDisabled": false,
    "allowedEmails": [
      "abc.xyz@gmail.com"
    ]
  },
  "database": {
    "type": "sqlite",
    "filename": "investments.db",
    "walMode": true,
    "location": "/data/investments.db"
  },
  "monitoring": {
    "healthCheckEndpoint": "/api/auth/config",
    "healthCheckInterval": 30
  }
}
