# Investment Tracker off-box backup config
# Copy to /etc/investtrack/backup-db.env on the server and fill in.
# This file is NOT secret (age recipient is a PUBLIC key) but keep it root-owned.
# B2 credentials live separately in the rclone config, not here.

# Path to the live SQLite database
DB_PATH=/data/investments.db

# rclone remote + path for the off-box destination (any rclone backend).
# Chosen: Google Drive. Configure the remote on Windows then ship rclone.conf
# to the server (see docs Runbook A). Keep the Drive folder PRIVATE.
# Format: <remote-name>:<folder>/<optional/subfolder>
RCLONE_REMOTE=gdrive:InvestTrackBackups/db

# Path to the rclone config that holds the B2 application key (root-owned, chmod 600)
RCLONE_CONFIG=/etc/investtrack/rclone.conf

# Where to keep local copies before/after upload
LOCAL_BACKUP_DIR=/data/backups

# Retention (days) applied to BOTH local and remote copies
RETENTION_DAYS=30
